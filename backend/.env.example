APP_ENV=development
APP_NAME=AI-Powered Library & Research Assistant
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/library_assistant
JWT_SECRET_KEY=replace-with-a-long-random-local-development-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_ORIGIN=http://localhost:5173

# Confirm provider/model/dimension with Member C before enabling embeddings.
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=

SERPAPI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
SUPPORT_EMAIL=
