# Copy to backend/.env for local development. Never commit real secrets.
APP_NAME=AI-Powered Library and Research Assistant
ENVIRONMENT=local
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/library_assistant

# Authentication: replace this with a random secret for local use.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Embeddings: provider and dimension must match the configured model.
EMBEDDING_MODEL=replace-with-your-embedding-model
EMBEDDING_DIMENSION=1536
LLM_MODEL=replace-with-your-llm-model
LLM_API_KEY=

# Research provider
SERPAPI_API_KEY=

# Email / reminders
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SUPPORT_EMAIL=
APP_TIMEZONE=Asia/Kolkata
OVERDUE_CHECK_CRON=0 9 * * *

# Analytics input (if using CSV export/import)
PURCHASE_LOG_PATH=./data/purchase_logs.csv

# Frontend origins; comma-separated
CORS_ORIGINS=http://localhost:5173
